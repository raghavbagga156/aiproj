{
  "name": "verihgn-headpath-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "Offline dashboard for the VeriHGN HEADPATH diagnostic experiment (reads a verified export bundle; no backend).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:vercel": "npm run build && node scripts/stage-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "plotly.js-dist-min": "2.35.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
